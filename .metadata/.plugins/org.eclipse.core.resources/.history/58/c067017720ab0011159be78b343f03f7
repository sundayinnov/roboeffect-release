void ADCKeyScanProcess_0(void)
{
    AdcKeyMsg KeyMsg;

    KeyMsg = AdcKeyScan();

    if(KeyMsg.index != ADC_KEY_UNKNOW && KeyMsg.type != KEY_UNKOWN_TYPE)
    {
		//printf("Key: %d, %d\n", KeyMsg.index, KeyMsg.type);
        if(KeyMsg.type == KEY_PRESSED || KeyMsg.type == KEY_LONG_PRESS_HOLD)
        {
			
            switch(KeyMsg.index)
            {
            case ADC_KEY_1:
				need_switch_mode = TRUE;
                break;

            case ADC_KEY_2:
                break;

            case ADC_KEY_3:
				if(roboeffect_get_effect_status(context_memory, 0x83))
				{
					roboeffect_enable_effect(context_memory, 0x83, 0);
				}
				else
				{
					roboeffect_enable_effect(context_memory, 0x83, 1);
				}
				need_update_status = 1;//tell acpworkbench to refresh effects data
                break;

            case ADC_KEY_4:
				hardware_pipe_reset(g_user_effect_list->sample_rate, 0);
                break;
				
            case ADC_KEY_5:
				if(mic_vol > 0) mic_vol --;
				AudioADC_PGAGainSet(ADC0_MODULE, CHANNEL_RIGHT, RIGHT_CHANNEL, mic_vol, 4);//30, 12, 44=0dB
				AudioADC_PGAGainSet(ADC0_MODULE, CHANNEL_LEFT, LEFT_CHANNEL, mic_vol, 4);//30, 12, 44=0dB
				printf("vol=%d\n", mic_vol);
                break;

            case ADC_KEY_6:
                if(mic_vol < 63) mic_vol ++;
				AudioADC_PGAGainSet(ADC0_MODULE, CHANNEL_RIGHT, RIGHT_CHANNEL, mic_vol, 4);//30, 12, 44=0dB
				AudioADC_PGAGainSet(ADC0_MODULE, CHANNEL_LEFT, LEFT_CHANNEL, mic_vol, 4);//30, 12, 44=0dB
				printf("vol=%d\n", mic_vol);
                break;

            default:
                break;
            }
        }
    }
}

