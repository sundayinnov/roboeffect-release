void flash_write_rand(uint32_t write_addr, uint8_t *data, uint32_t size, uint8_t help_buffer[4096*2])
{
	uint32_t erase_end = (write_addr + size + 0xFFF) & ~0xFFF;
	uint32_t erase_begin = write_addr & ~0xFFF;
	uint32_t data_tail = write_addr + size;


	//backup head
	memcpy(help_buffer, (void*)erase_begin, write_addr - erase_begin);

	//backup tail
	memcpy(help_buffer + 4096, (void*)data_tail, erase_end - data_tail);

	//erase
	FlashErase(erase_begin, (erase_end - erase_begin));

	//restore head
	SpiFlashWrite(erase_begin, help_buffer, write_addr - erase_begin, 100);

	//write real data
	SpiFlashWrite(write_addr, data, size, 100);

	//restore head
	SpiFlashWrite(write_addr + size, help_buffer + 4096, erase_end - data_tail, 100);

}



