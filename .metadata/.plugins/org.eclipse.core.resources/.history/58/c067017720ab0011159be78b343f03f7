void aec_and_fifo_init(void)
{
    // 1. 初始化AEC
    blue_aec_init(&aec_ctx, 3);

    // 2. 初始化MIC延时环
    MCUCircular_Config(&mic_delay_circular, mic_delay_buf, MIC_DELAY_BUF_SIZE * sizeof(int16_t));
    // 预填充静音（如果 DEFAULT_DELAY_BLK > 0）
    int16_t silence[AEC_FRAME_SIZE_16K] = {0};
    for (int i = 0; i < DEFAULT_DELAY_BLK; i++) {
        MCUCircular_PutData(&mic_delay_circular, silence, AEC_FRAME_SIZE_16K * sizeof(int16_t));
    }

    // 3. 初始化NS

    int32_t ret_ns = blue_ns_init(persistent_ns_aec, scratch_ns_aec, AEC_FRAME_SIZE_16K, 16);
    if (ret_ns == BLUENS_ERROR_OK) {
        DBG("NS initialized: blk=%d, level=%d\n", AEC_FRAME_SIZE_16K, ns_level);
    } else {
        DBG("NS init failed: %d\n", ret_ns);
//        ns_enable = 0;  // 初始化失败则禁用
    }

}


static void led_init(void)
{
	//LED init
	GPIO_PortAModeSet(GPIOA5, 0);
	GPIO_RegOneBitClear(GPIO_A_IE, GPIO_INDEX5);
	GPIO_RegOneBitSet(GPIO_A_OE, GPIO_INDEX5);
	GPIO_RegOneBitClear(GPIO_A_DS, GPIO_INDEX5);
	GPIO_RegOneBitClear(GPIO_A_OUT, GPIO_INDEX5);

	GPIO_PortAModeSet(GPIOA6, 0);
	GPIO_RegOneBitClear(GPIO_A_IE, GPIO_INDEX6);
	GPIO_RegOneBitSet(GPIO_A_OE, GPIO_INDEX6);
	GPIO_RegOneBitClear(GPIO_A_DS, GPIO_INDEX6);
	GPIO_RegOneBitClear(GPIO_A_OUT, GPIO_INDEX6);
}

static void led_play(void)
{
	//play LED
	if(roboeffect_get_effect_status(context_memory, 0x83))
		GPIO_RegOneBitSet(GPIO_A_OUT, GPIO_INDEX5);
	else
		GPIO_RegOneBitClear(GPIO_A_OUT, GPIO_INDEX5);
}

static char *get_graph_name(const uint8_t *script)
{
	static char graph_name[32] = {0};

	memset(graph_name, 0x00, sizeof(graph_name));
	if(script[3] == 0)//unencrypted
	{
		strncpy(graph_name, (char*)(&script[5]), (script[4]>sizeof(graph_name)-1)?(sizeof(graph_name)-1):(script[4])); 
	}
	else
	{
		strcpy(graph_name, "N/A");
	}

	return graph_name;
}

