		    // 半满时缓冲区中已有 bytes_per_frame/2 字节，对应样本数 = (bytes_per_frame/2) / 4
		    uint32_t threshold = (dma_buffer_bytes / 2) / 4;  // 4608/2/4 = 576 样本

