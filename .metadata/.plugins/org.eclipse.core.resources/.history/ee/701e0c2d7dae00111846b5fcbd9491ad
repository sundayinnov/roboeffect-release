}

static char *get_graph_name(const uint8_t *script)
{
	static char graph_name[32] = {0};

	memset(graph_name, 0x00, sizeof(graph_name));
	if(script[3] == 0)//unencrypted
	{
		strncpy(graph_name, (char*)(&script[5]), (script[4]>sizeof(graph_name)-1)?(sizeof(graph_name)-1):(script[4])); 
	}
	else
	{
		strcpy(graph_name, "N/A");
	}

	return graph_name;
}

