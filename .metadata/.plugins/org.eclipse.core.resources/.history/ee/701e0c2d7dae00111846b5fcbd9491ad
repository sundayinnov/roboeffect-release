static void play_audio_data(uint8_t *data, uint32_t length)
{
	uint32_t size;
	MemHandle mmHandle;
	uint8_t *decoder_buf = NULL;
	AudioDecoderContext *decoder_ctn;

	mv_mopen(&mmHandle, (uint8_t*)data, length, NULL);
	mmHandle.mem_len = length;

	decoder_buf = roboeffect_malloc(audio_decoder_get_memory_size(MP3_DECODER));

	if(decoder_buf && RT_SUCCESS == audio_decoder_initialize(decoder_buf, &mmHandle, IO_TYPE_MEMORY, MP3_DECODER))
	{
		uint32_t play_samples = 0;
		
		uint32_t play_sec, last_play_sec = 0, mute_count = 4;
		decoder_ctn = (AudioDecoderContext *)decoder_buf;

		DBG("[SONG_INFO]: ChannelCnt : %6d\n",		  (unsigned int)decoder_ctn->song_info.num_channels);
		DBG("[SONG_INFO]: SampleRate : %6d Hz\n",	  (unsigned int)decoder_ctn->song_info.sampling_rate);
		DBG("[SONG_INFO]: BitRate	 : %6d Kbps\n",   (unsigned int)decoder_ctn->song_info.bitrate / 1000);
		DBG("[SONG_INFO]: DecoderSize: %6d Bytes \n", (unsigned int)decoder_ctn->decoder_size);
		DBG("[SONG_INFO]: Duration	 : %02u:%02u:%02u\n",	  (unsigned int)(decoder_ctn->song_info.duration / 1000) / 3600, (unsigned int)((decoder_ctn->song_info.duration / 1000) % 3600) / 60, (unsigned int)((decoder_ctn->song_info.duration / 1000) % 3600) % 60);
		DBG("[SONG_INFO]: IsVBR 	 : %s\n",		  decoder_ctn->song_info.vbr_flag ? "   YES" : "    NO");

		DBG("[SONG_INFO]: CHARSET	 : %6d\n", (int)decoder_ctn->song_info.char_set);
		DBG("[SONG_INFO]: TITLE 	 : %s\n", decoder_ctn->song_info.title);
		DBG("[SONG_INFO]: ARTIST	 : %s\n", decoder_ctn->song_info.artist);
		DBG("[SONG_INFO]: ALBUM 	 : %s\n", decoder_ctn->song_info.album);
		DBG("[SONG_INFO]: COMMT 	 : %s\n", decoder_ctn->song_info.comment);
		DBG("[SONG_INFO]: GENRE 	 : %s\n", decoder_ctn->song_info.genre_str);
		DBG("[SONG_INFO]: YEAR		 : %s\n", decoder_ctn->song_info.year);
		DBG("[SONG_INFO]: TRACK 	 : %6d\n", decoder_ctn->song_info.track);
		DBG("\n");

		AudioDAC_SoftMute(DAC0, TRUE, TRUE);
		hardware_pipe_reset(decoder_ctn->song_info.sampling_rate, 512);

		while(RT_YES == audio_decoder_can_continue(decoder_ctn))
		{
			if(RT_SUCCESS == audio_decoder_decode(decoder_ctn))
			{
				while(AudioDAC0DataSpaceLenGet() < decoder_ctn->song_info.pcm_data_length);

				//suppose that decoder_ctn->song_info.pcm_addr is stereo buffer
				if(decoder_ctn->song_info.num_channels == 1)
				{
					upmix_1to2_apply((int16_t*)decoder_ctn->song_info.pcm_addr, (int16_t*)decoder_ctn->song_info.pcm_addr, decoder_ctn->song_info.pcm_data_length);
				}
				// DBG("%d\n", decoder_ctn->song_info.pcm_data_length);
				AudioDAC0DataSet(decoder_ctn->song_info.pcm_addr, decoder_ctn->song_info.pcm_data_length);

				play_samples += decoder_ctn->song_info.pcm_data_length;
				play_sec = play_samples / decoder_ctn->song_info.sampling_rate;
				if((play_sec % 3600) % 60 != last_play_sec)
				{
					DBG("play time: %02u:%02u:%02u\n", (unsigned int)play_sec / 3600, (unsigned int)(play_sec % 3600) / 60, (unsigned int)(play_sec % 3600) % 60);
					last_play_sec = (play_sec % 3600) % 60;
				}

				if(mute_count > 0 && --mute_count == 0)
				{
					AudioDAC_DigitalMute(DAC0, FALSE, FALSE);
				}
			}
			else
			{
				DBG("\n[INFO]: ERROR%d\n", (int)decoder_ctn->error_code);
				break;
			}
		}
	}
	else
	{
		DBG("decoder error.\n");
	}

	roboeffect_free(decoder_buf);
}

void determind_comm_mode(void)
{
	//2'b10: no pull-up, no pull-down
	// call these much early to get enough time to be pu
	// GPIO_RegOneBitSet(GPIO_B_PU, GPIO_INDEX1);
	// GPIO_RegOneBitClear(GPIO_B_PD, GPIO_INDEX1);
	// GPIO_RegOneBitSet(GPIO_B_DS, GPIO_INDEX1);

	// GPIO_RegOneBitSet(GPIO_B_PU, GPIO_INDEX0);
	// GPIO_RegOneBitClear(GPIO_B_PD, GPIO_INDEX0);
	// GPIO_RegOneBitSet(GPIO_B_DS, GPIO_INDEX0);

	//decided use iic or use usb-hid
	GPIO_PortBModeSet(GPIO_INDEX1, 0);
	GPIO_PortBModeSet(GPIO_INDEX0, 0);

	GPIO_RegOneBitSet(GPIO_B_IE, GPIO_INDEX1);
	GPIO_RegOneBitClear(GPIO_B_OE, GPIO_INDEX1);
	GPIO_RegOneBitClear(GPIO_B_ANA_EN, GPIO_INDEX1);
	GPIO_RegOneBitSet(GPIO_B_IE, GPIO_INDEX0);
	GPIO_RegOneBitClear(GPIO_B_OE, GPIO_INDEX0);
	GPIO_RegOneBitClear(GPIO_B_ANA_EN, GPIO_INDEX0);
	DelayMs(1); //pull up need time to setup

	DBG("mode0 = %d, mode1 = %d.\n", GPIO_RegOneBitGet(GPIO_B_IN, GPIO_INDEX1), GPIO_RegOneBitGet(GPIO_B_IN, GPIO_INDEX0));

	NVIC_SetPriority(Usb_IRQn, 0);
	NVIC_SetPriority(I2C_InIRQn, 0);
	NVIC_SetPriority(UART0_IRQn, 0);
	NVIC_SetPriority(Timer2_IRQn, 1);
	//NVIC_SetPriority(Timer3_IRQn, 1);
	//NVIC_SetPriority(Timer4_IRQn, 1);

	if ((GPIO_RegOneBitGet(GPIO_B_IN, GPIO_INDEX0) & 0x01))
	{
		connect_mode = MODE_HID;
		
	}
	else if ((GPIO_RegOneBitGet(GPIO_B_IN, GPIO_INDEX1) & 0x01))
	{
		connect_mode = MODE_UART;
	}
